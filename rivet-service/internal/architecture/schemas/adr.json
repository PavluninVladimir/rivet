{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "number",
    "title",
    "status",
    "date"
  ],
  "properties": {
    "number": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "superseded_by": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    }
  }
}
