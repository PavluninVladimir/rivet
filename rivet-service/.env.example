# Настройки стенда docker compose. Скопируйте файл в .env рядом с
# docker-compose.yml и заполните обязательные значения:
#   cp .env.example .env
# .env в git не попадает. Значения в этом файле намеренно пустые: пароль и
# ключ из примера знал бы любой, поэтому rivetd с опубликованными
# значениями не стартует.

# Обязательно. Пароль первого администратора, не короче 8 символов.
# Сгенерировать: openssl rand -base64 18
RIVET_ADMIN_PASSWORD=
# Логин первого администратора.
RIVET_ADMIN_LOGIN=admin

# Обязательно. Ключ шифрования секретов установки: токенов хостингов,
# ключей и секретных заголовков подключений к моделям. 32 байта в base64.
# Сгенерировать: openssl rand -base64 32
# Храните ключ отдельно от резервных копий базы. Сменить ключ на работающей
# установке: остановить rivetd и выполнить
#   RIVET_SECRET_KEY_OLD=<прежний> RIVET_SECRET_KEY=<новый> rivetd -rotate-key
RIVET_SECRET_KEY=

# Хостинг кода по умолчанию: fake (заглушка e2e-стенда) или github.
# Для настоящих pull request'ов: RIVET_SCM=github и токен бота.
RIVET_SCM=
RIVET_GITHUB_TOKEN=
RIVET_GITHUB_WEBHOOK_SECRET=
# Внешний адрес установки: нужен для автоматической регистрации webhook.
RIVET_PUBLIC_URL=

# Запасной ключ модели для декомпозиции Epic (основной задаётся в консоли).
RIVET_LLM_PROVIDER=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# TLS протокола runner'ов: пути к PEM-файлам внутри контейнера. rivetd в
# контейнере работает от uid 10001, файл ключа должен читаться им.
RIVET_GRPC_TLS_CERT=
RIVET_GRPC_TLS_KEY=
# mTLS, только вместе с TLS: путь к корням клиентских сертификатов
# runner'ов. CN или DNS SAN сертификата должен совпадать с идентификатором
# runner'а. Пусто: клиентские сертификаты не проверяются.
RIVET_GRPC_CLIENT_CA=

# Адрес исходного кода для ссылки «Исходный код» в консоли. Форк указывает
# свой репозиторий. Пусто значит публичный репозиторий Rivet.
RIVET_SOURCE_URL=
